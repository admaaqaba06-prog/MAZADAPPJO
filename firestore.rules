rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. User Profile Rules: Users can only read and write their OWN profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Wallets Rules: Restricted to the wallet owner only
    match /wallets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Auctions & Bid Logs:
    // Any authenticated user can read live auctions.
    // Only users whose account profile indicates "business" subscription tier are allowed to create an auction.
    match /auctions/{auctionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionTier == 'business';
      allow update, delete: if request.auth != null && 
        resource.data.sellerId == request.auth.uid;

      // Restrict subcollection direct client bids write (force backend / secured action)
      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow write: if false; 
      }
    }

    // 4. Bids collection rules
    match /bids/{bidId} {
      allow read: if request.auth != null;
      allow write: if false; // Denied to users directly; must be processed through backend / cloud flows
    }

    // 5. Default rules block
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
