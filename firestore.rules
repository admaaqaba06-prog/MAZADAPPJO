rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admaaqaba06@gmail.com';
    }

    // 1. Users block
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'admaaqaba06@gmail.com');
      allow create: if request.auth != null && request.auth.uid == userId && (
        request.resource.data.role == 'user' || (request.resource.data.role == 'admin' && request.auth.token.email == 'admaaqaba06@gmail.com')
      );
      allow update: if request.auth != null && (
        request.auth.token.email == 'admaaqaba06@gmail.com' || (
          request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isBlocked', 'subscriptionStatus', 'subscriptionExpiry', 'isVerified', 'wonCount'])
        )
      );
      allow delete: if request.auth != null && request.auth.token.email == 'admaaqaba06@gmail.com';
    }

    // 2. Auctions block
    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.createdById == request.auth.uid;
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && (isAdmin() || (resource.data.createdById == request.auth.uid && (resource.data.totalBids == 0 || resource.data.totalBids == null) && resource.data.status == 'upcoming'));
    }

    // 3. Bids subcollection (writable ONLY by Cloud Functions)
    match /auctions/{auctionId}/bids/{bidId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Wallets (writable ONLY by Cloud Functions)
    match /wallets/{walletId} {
      allow read: if isSignedIn() && (isOwner(walletId) || isAdmin());
      allow write: if false;
    }

    // 5. Escrow Transactions (writable ONLY by Cloud Functions)
    match /escrows/{escrowId} {
      allow read: if isSignedIn() && (isOwner(resource.data.bidderId) || isOwner(resource.data.sellerId) || isAdmin());
      allow write: if false;
    }

    // 6. Subscription Requests
    match /subscriptionRequests/{reqId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 7. Chats
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 8. Site Settings
    match /siteSettings/maintenanceMode {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/featureFlags {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{settingsId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 9. System Health Logs
    match /system_health/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if true;
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // 10. Analytics Events
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
