rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media uploads constraints: Limit to authenticated users, strict video format and 50MB size bounds
    match /auctions/{auctionId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.contentType.matches('video/mp4')
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Direct profile image assets storage paths
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
