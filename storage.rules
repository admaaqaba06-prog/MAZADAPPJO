rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (request.auth.token.role == "admin" || request.auth.token.admin == true);
    }

    // 1. Payment Proofs (Readable only by owner & admin; writable only by owner)
    match /payment-proofs/{userId}/{fileName} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 10 * 1024 * 1024; // Limit size to 10MB
      allow update, delete: if isAdmin();
    }

    // 2. Video Upload Path (Unified and restricted to 100MB size limit)
    match /auction-videos/{fileName} {
      allow read: if true;
      allow create: if isSignedIn()
                    && (request.resource.contentType.matches('video/.*')
                        || request.resource.contentType == 'application/octet-stream'
                        || request.resource.contentType == 'application/mp4')
                    && request.resource.size <= 100 * 1024 * 1024; // Expanded 100MB limit for high-quality mobile uploads
      allow update, delete: if isAdmin();
    }

    // 3. Thumbnails
    match /auction-thumbnails/{fileName} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    // Standard reject-all fallthrough
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
